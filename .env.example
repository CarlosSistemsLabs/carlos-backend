# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database (PostgreSQL) connection string used by Prisma.
# Pooling params (connection_limit, pool_timeout) are appended automatically
# from DATABASE_POOL_SIZE / DATABASE_POOL_TIMEOUT when not already present.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carlos_erp?schema=public

# Database connection pool tuning (Requirement 31.3).
# DATABASE_POOL_SIZE is the hard MAX connections per instance (Prisma
# connection_limit). DATABASE_POOL_MIN is an ADVISORY warm-connection target —
# Prisma has no native pool minimum, so it is documented/observed only, never
# encoded into the URL. DATABASE_POOL_TIMEOUT is the seconds to wait for a free
# connection (Prisma pool_timeout).
DATABASE_POOL_MIN=5
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=10

# Security: CORS
# Comma-separated whitelist of allowed origins. Leave empty to allow no
# cross-origin browser requests (server-to-server requests without an Origin
# header are still permitted).
CORS_ORIGIN=https://app.carlos-erp.com,https://carlos-erp.com

# Security: Rate limiting (per authenticated user, falling back to client IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Security: CSRF protection for state-changing operations.
# Disabled by default: the platform uses stateless JWT in the Authorization
# header (not cookies), which is not susceptible to CSRF. Enable only when
# cookie-based sessions are introduced.
CSRF_ENABLED=false

# Security: HSTS max-age in seconds advertised via Helmet (default 1 year)
HSTS_MAX_AGE=31536000

# -----------------------------------------------------------------------------
# Authentication: JWT (RS256)
# -----------------------------------------------------------------------------
# Access tokens are signed with RS256 using an asymmetric keypair. The values
# are PEM-encoded keys. In development and test these may be left empty: an
# ephemeral in-memory keypair is generated at startup so the app runs without
# managing real keys. In PRODUCTION both keys are REQUIRED (the app fails fast
# on boot if either is missing).
#
# Multi-line PEM values may be provided either as real newlines or with
# escaped "\n" sequences (which are expanded automatically) — the latter is
# convenient for single-line env managers.
#
# Generate a keypair locally with OpenSSL:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Access-token lifetime (e.g. 15m, 900s). Default: 15 minutes.
JWT_ACCESS_TTL=15m
# Refresh-token lifetime (e.g. 7d, 168h). Default: 7 days.
JWT_REFRESH_TTL=7d
# Issuer (`iss`) claim stamped on tokens and required on verification.
JWT_ISSUER=carlos-erp

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Analytics / Crashlytics / Remote Config)
# -----------------------------------------------------------------------------
# All Firebase settings are OPTIONAL. When no service-account credentials are
# provided the backend runs with Firebase DISABLED (a no-op client) so local
# development and tests need no real project.
#
# ENVIRONMENT SEPARATION (Requirement 14.2): TEST and PRODUCTION are separate
# Firebase projects. Each deployment simply sets these vars to ITS OWN project's
# values — the TEST deployment points at the TEST project, PRODUCTION at the
# PRODUCTION project. No code change is required; env is the only switch.
#
# Provide credentials via EITHER (precedence order):
#   1. FIREBASE_SERVICE_ACCOUNT      — the service-account JSON as a single-line
#                                      string (handy for secret managers).
#   2. FIREBASE_SERVICE_ACCOUNT_PATH — a path to the service-account JSON file.
# FIREBASE_PROJECT_ID overrides the project_id embedded in the service account.
#
# NOTE: `firebase-admin` must be installed (`npm i firebase-admin`) in CI / real
# deployments to activate the enabled path; it is loaded lazily so the app
# builds and runs without it when Firebase is disabled.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
